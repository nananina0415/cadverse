/**
 * [Contract] Fusion 360 Plugin -> Simulator Server
 * Target File: metadata.json
 * Description: Schema definition for AR/Simulator data export including metadata.
 */

// Root Structure
export interface PluginExportData {
    // Header information containing environment settings and metadata
    interface: InterfaceConfig;

    // Part transformation matrices (Key: Part Name, Value: Matrix)
    transforms: { [partName: string]: Matrix4x4 };

    // Hierarchy and connection details
    joints: JointData[];
}

// Configuration Header
export interface InterfaceConfig {
    // -------------------------------------------------
    // 1. Metadata & Versioning
    // -------------------------------------------------
    version: string;              // e.g., "1.0.0"
    created_at: string;           // ISO 8601 Date String
    source_asset_name: string;    // e.g., "Robot_Arm_v3"

    // -------------------------------------------------
    // 2. Physics & Space Settings
    // -------------------------------------------------
    len_unit: "cm" | "mm" | "m";
    up_axis: "Z" | "Y";
    handedness: "right" | "left"; // Fusion=right, Unity=left
    matrix_format: "row_major_4x4" | "column_major_4x4";
    joint_types: JointType[];
}

// Joint Detail
export interface JointData {
    name: string;
    type: JointType;
    connected_parts: {
        parent: string;
        child: string;
    };
    axis: Vector3;
    origin: Vector3;
    limits: {
        min: number | null;
        max: number | null;
    };
}

// Type Definitions
export type JointType = "Revolute" | "Slider" | "Rigid" | "Ball";

export type Vector3 = [number, number, number];

export type Matrix4x4 = [
    number, number, number, number,
    number, number, number, number,
    number, number, number, number,
    number, number, number, number
];
